# Copy to .env and fill in real values. Never commit .env.

# --- Database (docker-compose) ---
POSTGRES_USER=planner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel_planner
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://planner:change-me@localhost:5432/travel_planner
# Logs: text (readable) | json (one object per line, for a log collector)
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# --- LLM ---
# gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional tuning (defaults in backend/app/config.py and app/llm/factory.py)
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
# One call ends by then, retries included
# LLM_DEADLINE_S=40
# After this many failed calls in a row, the LLM is not called for the cooldown
# LLM_CIRCUIT_FAILURES=3
# LLM_CIRCUIT_COOLDOWN_S=60
# LLM_DAILY_TOKEN_BUDGET=1000000
# Requests per client to the endpoints that call the LLM (0 turns a limit off)
# AI_REQUESTS_PER_MINUTE=5
# AI_REQUESTS_PER_DAY=100

# --- Routing ---
# osrm (real walking distances, falls back to haversine) | haversine
# ROUTING_PROVIDER=osrm
# The public FOSSGIS server by default; the self-hosted one (osrm/, `docker compose
# --profile osrm up -d`) is much faster: http://localhost:5000
# OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot

# --- Public transport ---
# HERE Public Transit API key (https://platform.here.com): real metro/tram/bus/train routes
# and timetables. Without it, ride times are a fixed-speed estimate.
HERE_API_KEY=
# here | estimate (ignore the key)
# TRANSIT_PROVIDER=here
# HERE_TIMEOUT_S=8

# --- Weather ---
# OpenWeatherMap API key (https://home.openweathermap.org/api_keys; the free plan is enough):
# the forecast for every planned day and stop, and weather-aware routing. Without it,
# plans have no weather.
OPENWEATHER_API_KEY=
# OPENWEATHER_TIMEOUT_S=5

# --- Map tiles ---
# A Mapbox public token (pk.…, https://console.mapbox.com/account/access-tokens/): the
# production stack builds it into the frontend as NEXT_PUBLIC_MAPBOX_TOKEN. Restrict it to the
# site's URLs; for `npm run dev`, set NEXT_PUBLIC_MAPBOX_TOKEN in frontend/.env.local instead.
MAPBOX_MAP_KEY=
# MAPBOX_STYLE=mapbox/streets-v12

# --- Production stack (docker-compose.prod.yml) ---
# A domain name gets HTTPS from Caddy (then set SESSION_COOKIE_SECURE=true); :80 is plain HTTP.
# SITE_ADDRESS=:80
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Accounts ---
# How long a log-in lasts, in days.
# SESSION_DAYS=30
# Mark the session cookie Secure: set to true wherever the site is served over HTTPS.
# SESSION_COOKIE_SECURE=false
