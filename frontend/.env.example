# Optional. Copy to .env.local to override the defaults below.

# FastAPI backend that /api/* is proxied to (read when next.config.ts loads: dev, build, start).
# BACKEND_URL=http://localhost:8000

# Deployed with the API at its own address too (Render): the same value as the API's
# ORIGIN_SECRET. Server-only: src/proxy.ts adds it to the /api requests; never NEXT_PUBLIC_.
# ORIGIN_SECRET=

# Map tiles (src/lib/tiles.ts), inlined into the browser code at build time.
# A Mapbox public token (pk.…, https://console.mapbox.com/account/access-tokens/; restrict
# it to the site's URLs there) draws the map from a Mapbox style, Mapbox Streets by default.
# Without one, tiles come from the public OpenStreetMap server: fine for development, not for
# real traffic (https://operations.osmfoundation.org/policies/tiles/).
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12
# Any other provider instead (takes precedence over Mapbox):
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
